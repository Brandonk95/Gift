# Copy to .env and adjust. Restart the container after changes.

# ---- App
APP_NAME=GiftMe
# Public URL people use to reach the app. No trailing slash. Email links use the
# address the person who caused the email was on, if it's listed here (separate
# several with commas; the first is the default) or a home-network/Tailscale
# address (localhost, 192.168.x, 10.x, 172.16-31.x, 100.64-127.x, *.local).
# Other addresses get the default, so nobody can redirect your reset links.
APP_URL=http://localhost:8090
# ISO currency code for prices
APP_CURRENCY=USD
# Host port to publish
HOST_PORT=8090

# ---- Admin dashboard (http://localhost:8090/_/)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-long-password

# ---- SMTP (leave SMTP_HOST empty to disable email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true = implicit TLS (port 465). false = STARTTLS (port 587). Defaults to true on 465.
SMTP_TLS=false
# PLAIN (default) or LOGIN
SMTP_AUTH_METHOD=PLAIN
SMTP_SENDER_ADDRESS=noreply@example.com
SMTP_SENDER_NAME=GiftMe

# Button/logo color in emails (#rrggbb)
# EMAIL_ACCENT=#c8364f

# Photo search in the gift editor ("Find photos online", and automatic for Amazon and
# stores that block previews). Free key: https://brave.com/search/api
# BRAVE_SEARCH_KEY=

# Time zone for the nightly "new gifts" emails to followers, e.g. America/New_York (default UTC)
# TZ=America/Denver
# Hour to send them, 0-23 (default 0 = midnight)
# DIGEST_HOUR=0

# How many days a reservation lasts before the person has to renew it.
# RESERVATION_DAYS=7
